<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      悬浮球（语音唤醒入口）所需：
        SYSTEM_ALERT_WINDOW  在其他应用之上显示悬浮窗。属于「特殊权限」，
                             无法运行时申请，必须引导用户到系统设置手动开启。
        FOREGROUND_SERVICE   让悬浮球常驻，不被系统在内存紧张时回收。
        POST_NOTIFICATIONS   Android 13+ 前台服务需要通知（未授予也不影响悬浮球本身）。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Android 11+ 包可见性：必须声明要查询 TTS 引擎，否则
      listTtsEngines() 拿不到引擎列表，就发现不了「Fairy 语音引擎」，
      也就无法自动优先使用它。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name_display"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name_display"
            android:theme="@style/Theme.FairyMobile"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|screenLayout|smallestScreenSize|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          崩溃展示页：声明为**独立进程**，这样即使主进程在启动阶段崩溃，
          它仍能被拉起，把日志显示出来并自动复制到剪贴板。
        -->
        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:process=":crash"
            android:excludeFromRecents="true"
            android:label="@string/app_name_display"
            android:theme="@style/Theme.FairyMobile" />

        <!--
          悬浮球服务：常驻的语音唤醒入口。
          替代了原先「后台常驻监听唤醒词」的做法 —— 后者要一直占用麦克风，
          耗电且易被 ROM 限制；悬浮球只需一次点击，交互也更明确。

          ⚠ 刻意**不声明 foregroundServiceType**：
          真机（Xiaomi / Android 15）曾因前台服务超时崩溃
          （ForegroundServiceDidNotStartInTimeException）。悬浮球只是一个窗口，
          不具备麦克风/定位等受限类型，用普通服务 + 常驻通知即可，
          从根上避开 5 秒限制与类型校验。
        -->
        <service
            android:name=".FloatingBallService"
            android:exported="false"
            android:enabled="true"
            android:stopWithTask="false" />
    </application>

</manifest>
